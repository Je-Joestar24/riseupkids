# Server Configuration
PORT=5000
NODE_ENV=development
# Number of reverse-proxy hops in front of the API (Express `trust proxy`). Default 1 (a single
# nginx). Needed so per-IP rate limiting sees the real client IP. Set to 0 if the API is exposed
# directly with no proxy. Do NOT over-set it — that lets clients spoof X-Forwarded-For.
TRUST_PROXY=1

# Auth endpoint rate limits (RUK-SEC-007). Defaults are sensible; override only to tune.
# AUTH_LOGIN_MAX=20                 # login + verify-login-otp, per IP
# AUTH_LOGIN_WINDOW_MS=900000       # 15 min
# AUTH_REGISTER_MAX=10              # register + subscribe-flodesk, per IP
# AUTH_REGISTER_WINDOW_MS=3600000   # 60 min
# AUTH_PASSWORD_RESET_MAX=10        # forgot-password + reset-password + resend-login-otp, per IP
# AUTH_PASSWORD_RESET_WINDOW_MS=3600000  # 60 min
# PUBLIC_FORM_MAX=8                 # /api/invitation + /api/school-application, per IP
# PUBLIC_FORM_WINDOW_MS=3600000     # 60 min

# Per-account lockout after repeated failed password logins (RUK-SEC-007).
# Loosen these locally if manual testing keeps locking you out.
# LOGIN_LOCKOUT_THRESHOLD=8              # failed attempts before the account locks
# LOGIN_LOCKOUT_BASE_MS=60000            # first lock = 1 min; doubles each further failure
# LOGIN_LOCKOUT_MAX_MS=3600000           # cap on a single lock (60 min)
# LOGIN_LOCKOUT_ATTEMPT_RESET_MS=86400000  # forget a stale failed-attempt count after 24h quiet

# Wrong-guess caps on the 6-digit codes (RUK-SEC-007). The code is destroyed after this many
# wrong guesses and the user must request a new one.
# LOGIN_OTP_MAX_ATTEMPTS=5              # admin login OTP
# PASSWORD_RESET_CODE_MAX_ATTEMPTS=5   # password-reset code

# HTTP Strict-Transport-Security max-age in seconds (RUK-SEC-009). Default 86400 (1 day) —
# conservative and self-healing. Set to 0 to disable instantly with no deploy. Once you've
# confirmed nothing calls the API over plain http://, raise to 15552000 (180 days).
# HSTS_MAX_AGE=86400

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/riseupkids
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/riseupkids
# Optional: exact Mongo collection name for Star Cam categories (default starcamcategories). Set if your data uses another name; restart the API after changing.
# STARCAM_CATEGORY_COLLECTION=starcamcategories

# JWT Configuration
# REQUIRED. Generate a real random secret — the server refuses to start without one:
#   openssl rand -hex 32
# Never use a placeholder/example value; never commit the real value.
JWT_SECRET=
JWT_EXPIRE=7d

# Days shown to parents for self-service deletion completion (default 30)
ACCOUNT_DELETION_DAYS=30
# Automatic purge of due deletion requests (default: enabled in production)
DELETION_SCHEDULER_ENABLED=true
# How often to check for due deletions in ms (default 86400000 = 24h)
DELETION_SCHEDULER_INTERVAL_MS=86400000
# Cluster lock TTL for scheduler in ms (default 300000 = 5m)
DELETION_SCHEDULER_LOCK_MS=300000
# Reset processing requests stuck longer than this many minutes (default 60)
DELETION_PROCESSING_STALE_MINUTES=60

# CORS Configuration (only applies to browser: Expo web, web frontend)
# Comma-separated list. In development, localhost/127.0.0.1 and *.expo.run are allowed even if unset.
# Example for web + Expo web: http://localhost:3000,http://localhost:8081
CORS_ORIGIN=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# CMS book / Star Cam audio — trim leading/trailing silence before S3/CloudFront upload
# Requires @ffmpeg-installer/ffmpeg (bundled with npm install) or system ffmpeg on PATH
AUDIO_SILENCE_TRIM_ENABLED=true
# Only near-zero (literal) silence is trimmed; any audible content is kept (-96 dB default)
AUDIO_SILENCE_TRIM_THRESHOLD_DB=-96
AUDIO_SILENCE_TRIM_TRAILING_THRESHOLD_DB=-96
AUDIO_SILENCE_TRIM_MIN_SILENCE_SEC=0.12
AUDIO_SILENCE_TRIM_MIN_TRAILING_SILENCE_SEC=0.25
AUDIO_SILENCE_TRIM_PAD_MS=200
AUDIO_SILENCE_TRIM_TRAILING_PAD_MS=400
# 0 = full-band detection (recommended). Set e.g. 400 only to ignore low hum during analysis.
AUDIO_SILENCE_TRIM_HIGHPASS_HZ=0

# ---- Stripe (US / international Family Plan checkout) ----
# Server-side secret — NEVER commit the real value, NEVER expose to the frontend.
# STRIPE_SECRET_KEY=sk_live_or_test_xxx
# Verifies incoming Stripe webhook signatures (Stripe Dashboard > Developers > Webhooks).
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Product + yearly price the Family Plan maps to. Create with scripts/createStripePrices.js,
# which also writes config/stripeFamilyPlanPrices.json.
# STRIPE_PRODUCT_ID=prod_xxx
# STRIPE_PRICE_ID_YEARLY=price_xxx
# STRIPE_FAMILY_PLAN_PRODUCT_NAME=Rise Up Kids Family Plan

# ---- PayPal (one-time / Pay-in-4 checkout) ----
# PAYPAL_ENV=sandbox                       # sandbox | live
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com   # https://api-m.paypal.com for live
# PAYPAL_CLIENT_ID=xxx
# PAYPAL_CLIENT_SECRET=xxx                 # server-side secret — never expose to the frontend

# ---- AWS S3 + CloudFront (media, audio, images, HTML5 content) ----
# Without these, the API falls back to local ./uploads and media delivery breaks in production.
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx                # server-side secret
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=riseupkids-media
# AWS_S3_BASE_URL=https://media.riseup.kids   # CloudFront URL that fronts the bucket
# CLOUDFRONT_DISTRIBUTION_ID=E1XXXXXXXXXX     # for cache invalidation after content updates
# Max bytes for an explore-video upload (default 524288000 = 500 MB)
# EXPLORE_VIDEO_MAX_BYTES=524288000

# Flodesk (email signup / form segment)
# Get your API key from Flodesk: Account > Integrations > API Keys
FLODESK_API_KEY=your_flodesk_api_key_here
# Segment ID to add subscribers to. SUBSCRIBED_FORM_ID or FLODESK_SEGMENT_ID (same purpose —
# must be the SEGMENT id, not the form id). Run: node scripts/listFlodeskSegments.js
SUBSCRIBED_FORM_ID=your_segment_id_here
# FLODESK_SEGMENT_ID=your_segment_id_here
# Segment IDs for parent invitation form (POST /api/invitation) — one per language workflow.
# Extract from the Flodesk URL path: https://app.flodesk.com/segment/<id>
FLODESK_PARENT_SEGMENT_EN=your_parent_segment_id_en
FLODESK_PARENT_SEGMENT_ES=your_parent_segment_id_es
FLODESK_PARENT_SEGMENT_PT=your_parent_segment_id_pt
# Segment IDs for schools page (POST /api/school-application) — one per language workflow
FLODESK_SCHOOL_SEGMENT_EN=your_school_segment_id_en
FLODESK_SCHOOL_SEGMENT_ES=your_school_segment_id_es
FLODESK_SCHOOL_SEGMENT_PT=your_school_segment_id_pt
# Optional; default is https://api.flodesk.com/v1
# FLODESK_BASE_URL=https://api.flodesk.com/v1

# Backend public URL (for email logo and links; e.g. http://localhost:5000)
BACKEND_BASE_URL=http://localhost:5000

# PagBank / PagSeguro Checkout (Brazil — server only, never expose to frontend)
# PAGSEGURO_ENV=sandbox
# PAGSEGURO_API_BASE=https://sandbox.api.pagseguro.com
# PAGSEGURO_ACCESS_TOKEN=your_sandbox_bearer_token    # server-side secret
# Optional if iBanking signing token differs from Connect Bearer (webhook SHA256)
# PAGSEGURO_WEBHOOK_TOKEN=
# CloudFront/API gateway must forward x-authenticity-token and raw POST body unchanged
# PAGSEGURO_INSTALLMENTS_LIMIT=12
# PAGSEGURO_INTEREST_FREE_INSTALLMENTS=12
# PAGSEGURO_SOFT_DESCRIPTOR=RISEUPKIDS
# PAGSEGURO_DEBUG=false                     # true = log verify/webhook diagnostics
# API_PUBLIC_BASE_URL=https://your-api.example.com
# SALE_APP_BASE_URL=https://riseup.kids

# ---- Google Cloud Vision (Star Cam object recognition) ----
# Feature-flagged. When enabled, the fields below are a Google service-account key split into
# env vars — GOOGLE_VISION_PRIVATE_KEY is a real secret (keep the literal \n escapes).
# GOOGLE_VISION_ENABLED=false
# GOOGLE_VISION_PROJECT_ID=xxx
# GOOGLE_VISION_PRIVATE_KEY_ID=xxx
# GOOGLE_VISION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_VISION_CLIENT_EMAIL=vision@xxx.iam.gserviceaccount.com
# GOOGLE_VISION_CLIENT_ID=xxx
# GOOGLE_VISION_TOKEN_URI=https://oauth2.googleapis.com/token
# GOOGLE_VISION_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# GOOGLE_VISION_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# GOOGLE_VISION_CLIENT_X509_CERT_URL=xxx
# GOOGLE_VISION_UNIVERSE_DOMAIN=googleapis.com
# Detection tuning (optional):
# VISION_CONFIDENCE_THRESHOLD=0.6
# VISION_LABEL_MAX_RESULTS=15
# VISION_REQUEST_TIMEOUT_MS=15000
# VISION_RETURN_LABEL_PREVIEW=false
# STARCAM_DETECT_DEBUG=false

# ---- Google / YouTube OAuth (live-class + explore-video integrations) ----
# Feature-flagged; only needed if those integrations are turned on.
# USE_GOOGLE_OAUTH=false
# GOOGLE_CLIENT_ID=xxx
# GOOGLE_CLIENT_SECRET=xxx                  # server-side secret
# GOOGLE_REDIRECT_URI=https://api.riseup.kids/api/google/oauth/callback
# USE_YOUTUBE_OAUTH=false
# YOUTUBE_CLIENT_ID=xxx
# YOUTUBE_CLIENT_SECRET=xxx                 # server-side secret
# YOUTUBE_REDIRECT_URI=https://api.riseup.kids/api/youtube/oauth/callback
# YOUTUBE_CHANNEL_ID=xxx

# ---- Expo push notifications ----
# EXPO_ACCESS_TOKEN=xxx                     # server-side secret (Expo account access token)
# EXPO_PUSH_ACCESS_TOKEN=xxx                # alias some code paths read; set the same value

# ---- Notification scheduler ----
# NOTIFICATION_SCHEDULER_ENABLED=true       # default: enabled in production
# NOTIFICATION_SCHEDULER_INTERVAL_MS=60000
# NOTIFICATION_SCHEDULER_LOCK_MS=300000
# NOTIFICATION_TEST_USER_ID=                # restrict "send test" to one user id (optional)

# ---- Program materials (printable worksheet links) ----
# PROGRAM_MATERIALS_BASE_URL=https://media.riseup.kids/program-materials
# PROGRAM_MATERIALS_PAGES_PER_STEP=2
# PROGRAM_MATERIALS_AHEAD_STEPS=1
# PROGRAM_MATERIALS_MAX_STEP=40

# ---- Misc ----
# Public URL of the web frontend (used in some email links). Defaults from BACKEND_BASE_URL context.
# FRONTEND_BASE_URL=https://app.riseup.kids
# Node request timeout in ms for slow large uploads. 0 = no timeout (default).
# HTTP_REQUEST_TIMEOUT_MS=0

# ---- Mail (transactional: password reset, etc.) ----
# Driver: log (dev, no send) | sendmail (no keys) | smtp (e.g. Gmail)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@riseup.kids
MAIL_FROM_NAME="Rise Up Kids LMS"
# SENDMAIL_PATH=/usr/sbin/sendmail
# SMTP (when MAIL_DRIVER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
