# Server Configuration
PORT=5000
NODE_ENV=development
# Number of reverse-proxy hops in front of the API (Express `trust proxy`). Default 1 (a single
# nginx). Needed so per-IP rate limiting sees the real client IP. Set to 0 if the API is exposed
# directly with no proxy. Do NOT over-set it — that lets clients spoof X-Forwarded-For.
TRUST_PROXY=1

# Auth endpoint rate limits (RUK-SEC-007). Defaults are sensible; override only to tune.
# AUTH_LOGIN_MAX=20                 # login + verify-login-otp, per IP
# AUTH_LOGIN_WINDOW_MS=900000       # 15 min
# AUTH_REGISTER_MAX=10              # register + subscribe-flodesk, per IP
# AUTH_REGISTER_WINDOW_MS=3600000   # 60 min
# AUTH_PASSWORD_RESET_MAX=10        # forgot-password + reset-password + resend-login-otp, per IP
# AUTH_PASSWORD_RESET_WINDOW_MS=3600000  # 60 min
# PUBLIC_FORM_MAX=8                 # /api/invitation + /api/school-application, per IP
# PUBLIC_FORM_WINDOW_MS=3600000     # 60 min

# Per-account lockout after repeated failed password logins (RUK-SEC-007).
# Loosen these locally if manual testing keeps locking you out.
# LOGIN_LOCKOUT_THRESHOLD=8              # failed attempts before the account locks
# LOGIN_LOCKOUT_BASE_MS=60000            # first lock = 1 min; doubles each further failure
# LOGIN_LOCKOUT_MAX_MS=3600000           # cap on a single lock (60 min)
# LOGIN_LOCKOUT_ATTEMPT_RESET_MS=86400000  # forget a stale failed-attempt count after 24h quiet

# Wrong-guess caps on the 6-digit codes (RUK-SEC-007). The code is destroyed after this many
# wrong guesses and the user must request a new one.
# LOGIN_OTP_MAX_ATTEMPTS=5              # admin login OTP
# PASSWORD_RESET_CODE_MAX_ATTEMPTS=5   # password-reset code

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/riseupkids
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/riseupkids
# Optional: exact Mongo collection name for Star Cam categories (default starcamcategories). Set if your data uses another name; restart the API after changing.
# STARCAM_CATEGORY_COLLECTION=starcamcategories

# JWT Configuration
# REQUIRED. Generate a real random secret — the server refuses to start without one:
#   openssl rand -hex 32
# Never use a placeholder/example value; never commit the real value.
JWT_SECRET=
JWT_EXPIRE=7d

# Days shown to parents for self-service deletion completion (default 30)
ACCOUNT_DELETION_DAYS=30
# Automatic purge of due deletion requests (default: enabled in production)
DELETION_SCHEDULER_ENABLED=true
# How often to check for due deletions in ms (default 86400000 = 24h)
DELETION_SCHEDULER_INTERVAL_MS=86400000
# Cluster lock TTL for scheduler in ms (default 300000 = 5m)
DELETION_SCHEDULER_LOCK_MS=300000
# Reset processing requests stuck longer than this many minutes (default 60)
DELETION_PROCESSING_STALE_MINUTES=60

# CORS Configuration (only applies to browser: Expo web, web frontend)
# Comma-separated list. In development, localhost/127.0.0.1 and *.expo.run are allowed even if unset.
# Example for web + Expo web: http://localhost:3000,http://localhost:8081
CORS_ORIGIN=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# CMS book / Star Cam audio — trim leading/trailing silence before S3/CloudFront upload
# Requires @ffmpeg-installer/ffmpeg (bundled with npm install) or system ffmpeg on PATH
AUDIO_SILENCE_TRIM_ENABLED=true
# Only near-zero (literal) silence is trimmed; any audible content is kept (-96 dB default)
AUDIO_SILENCE_TRIM_THRESHOLD_DB=-96
AUDIO_SILENCE_TRIM_TRAILING_THRESHOLD_DB=-96
AUDIO_SILENCE_TRIM_MIN_SILENCE_SEC=0.12
AUDIO_SILENCE_TRIM_MIN_TRAILING_SILENCE_SEC=0.25
AUDIO_SILENCE_TRIM_PAD_MS=200
AUDIO_SILENCE_TRIM_TRAILING_PAD_MS=400
# 0 = full-band detection (recommended). Set e.g. 400 only to ignore low hum during analysis.
AUDIO_SILENCE_TRIM_HIGHPASS_HZ=0

# Stripe Configuration (Future)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Flodesk (email signup / form segment)
# Get your API key from Flodesk: Account > Integrations > API Keys
FLODESK_API_KEY=your_flodesk_api_key_here
# Form/segment ID to add subscribers to (from your Flodesk form)
SUBSCRIBED_FORM_ID=your_form_id_here
# Segment IDs for parent invitation form (POST /api/invitation) — one per language workflow
# Extract from Flodesk URL path: .../segment/<id>
# EN: https://app.flodesk.com/segment/6a3a6701c951745ff9f28cd8
FLODESK_PARENT_SEGMENT_EN=6a3a6701c951745ff9f28cd8
# ES: https://app.flodesk.com/segment/6a3a66f6f31a7c2cdd8b2c6f
FLODESK_PARENT_SEGMENT_ES=6a3a66f6f31a7c2cdd8b2c6f
# PT: https://app.flodesk.com/segment/6a3a66e7f5968997758b4712
FLODESK_PARENT_SEGMENT_PT=6a3a66e7f5968997758b4712
# Segment IDs for schools page (POST /api/school-application) — one per language workflow
FLODESK_SCHOOL_SEGMENT_EN=6a26b4a83e683dae80d0eae9
FLODESK_SCHOOL_SEGMENT_ES=6a26b505c6a4160d3a136820
FLODESK_SCHOOL_SEGMENT_PT=6a26b4bb6b0d638a5d97ac60
# Optional; default is https://api.flodesk.com/v1
# FLODESK_BASE_URL=https://api.flodesk.com/v1

# Backend public URL (for email logo and links; e.g. http://localhost:5000)
BACKEND_BASE_URL=http://localhost:5000

# PagBank / PagSeguro Checkout (Brazil — server only, never expose to frontend)
# PAGSEGURO_ENV=sandbox
# PAGSEGURO_API_BASE=https://sandbox.api.pagseguro.com
# PAGSEGURO_ACCESS_TOKEN=your_sandbox_bearer_token
# Optional if iBanking signing token differs from Connect Bearer (webhook SHA256)
# PAGSEGURO_WEBHOOK_TOKEN=
# CloudFront/API gateway must forward x-authenticity-token and raw POST body unchanged
# PAGSEGURO_INSTALLMENTS_LIMIT=12
# PAGSEGURO_INTEREST_FREE_INSTALLMENTS=12
# PAGSEGURO_SOFT_DESCRIPTOR=RISEUPKIDS
# API_PUBLIC_BASE_URL=https://your-api.example.com
# SALE_APP_BASE_URL=https://riseup.kids

# ---- Mail (transactional: password reset, etc.) ----
# Driver: log (dev, no send) | sendmail (no keys) | smtp (e.g. Gmail)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@riseup.kids
MAIL_FROM_NAME="Rise Up Kids LMS"
# SENDMAIL_PATH=/usr/sbin/sendmail
# SMTP (when MAIL_DRIVER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
