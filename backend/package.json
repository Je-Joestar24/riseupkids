{
  "name": "riseupkids-backend",
  "version": "1.0.0",
  "description": "Backend API for Rise Up Kids - Child Learning Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeders/userSeeder.js",
    "seed:badges": "node scripts/seedBadges.js",
    "seed:starcam-categories": "node scripts/seedStarCamCategories.js",
    "seed:starcam-missions": "node scripts/seedStarCamMissions.js",
    "seed:paypal": "node scripts/createPayPalPlans.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand"
  },
  "keywords": [
    "lms",
    "education",
    "children",
    "learning"
  ],
  "author": "Jejomar Parrilla",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1010.0",
    "@aws-sdk/client-s3": "^3.993.0",
    "@google-cloud/vision": "^5.3.5",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "fs-extra": "^11.3.3",
    "googleapis": "^170.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^8.0.2",
    "path": "^0.12.7",
    "stripe": "^20.2.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "collectCoverageFrom": [
      "services/**/*.js",
      "!**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
