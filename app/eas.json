      "env": {
        "EXPO_PUBLIC_API_URL": "https://dp6jg4onafzr1.cloudfront.net/api",
        "EXPO_PUBLIC_CMS_VIDEO_DEBUG": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
