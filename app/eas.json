{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "key": "android-fcm-cng-prebuild-v5"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.riseup.kids/api"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.riseup.kids/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.riseup.kids/api"
      }
    },
    "screenshots": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.riseup.kids/api",
        "EXPO_PUBLIC_ALLOW_SCREEN_CAPTURE": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
