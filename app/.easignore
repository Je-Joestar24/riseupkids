# Sibling projects (EAS archives from git root - exclude these large folders)
backend/
frontend/
.cursor/

# Dependencies (EAS runs npm install on the server)
node_modules/

# Git
.git/
.gitignore

# Expo/Metro
.expo/
dist/
web-build/
expo-env.d.ts

# Native build folders — EAS must run `expo prebuild` so google-services.json
# is copied and `com.google.gms.google-services` is applied. Uploading a local
# android/ folder skips that and Firebase never initializes.
ios/
android/

# Public Firebase client file (required for Android FCM token minting).
!google-services.json

# Debug and logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Environment files (use EAS Secrets instead)
.env
.env.*
.env*.local

# Documentation (not needed for build)
*.md
!README.md

# IDE and OS
.vscode/
.idea/
.DS_Store
