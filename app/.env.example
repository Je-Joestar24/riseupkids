# Copy to app/.env and restart Expo (npx expo start -c) after changes.

# Force Kids Wall Coming Soon on all platforms (PC web, Android, iOS) for QA.
# Production iOS already enables Coming Soon without this flag.
EXPO_PUBLIC_KIDS_WALL_COMING_SOON_PREVIEW=true

# Optional: set to false to disable Coming Soon on real iOS builds.
# EXPO_PUBLIC_KIDS_WALL_COMING_SOON=false

# Temporary push debugger overlay. Must be exactly true. Missing, false, or commented out = hidden.
# Restart Metro (-c) or rebuild the APK after changing this.
# EXPO_PUBLIC_PUSH_DEBUG=true
