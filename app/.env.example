# Copy to app/.env and restart Expo (npx expo start -c) after changes.
# Only EXPO_PUBLIC_* vars are readable in the app bundle — never put a secret here, it ships
# to every device. There are no app-side secrets today; the API holds all credentials.

# ---- API ----
# Backend API base URL, including /api. Defaults to production if unset.
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
# Backend origin without /api (for WebView URLs, e.g. HTML5 launch). Derived from API_URL if unset.
# EXPO_PUBLIC_BACKEND_ORIGIN=http://localhost:5000
# Log the resolved API base URL on startup (always on in __DEV__).
# EXPO_PUBLIC_LOG_API_URL=false

# ---- Kids Wall ----
# Force the "Coming Soon" state on all platforms (PC web, Android, iOS) for QA.
# Production iOS already forces Coming Soon regardless of this flag.
EXPO_PUBLIC_KIDS_WALL_COMING_SOON_PREVIEW=true
# Set to false to disable Coming Soon on real iOS builds.
# EXPO_PUBLIC_KIDS_WALL_COMING_SOON=false

# ---- Debug overlays (must be exactly the string "true"; rebuild/-c after changing) ----
# EXPO_PUBLIC_PUSH_DEBUG=true
# EXPO_PUBLIC_CMS_AUDIO_DEBUG=true
# EXPO_PUBLIC_CMS_VIDEO_DEBUG=true
