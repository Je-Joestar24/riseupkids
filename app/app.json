{
  "expo": {
    "name": "Rise Up Kids",
    "slug": "riseupkids",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/lms-logo.png",
    "scheme": "riseupkids",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#62caca",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.riseupkids.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lms-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Rise Up Kids needs camera access to run Star Cam practice mode."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rise Up Kids needs photo library access so children can choose images to share."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Rise Up Kids needs microphone access for audio recording activities."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lms-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#62caca",
          "dark": {
            "backgroundColor": "#0f172a"
          }
        }
      ],
      "expo-font",
      "expo-file-system",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e3d66b4b-fc7d-4275-a06b-d2d30c1ce868"
      }
    },
    "owner": "jejomarp"
  }
}
